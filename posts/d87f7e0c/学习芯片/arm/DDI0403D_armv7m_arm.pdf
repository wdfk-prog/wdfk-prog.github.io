         <pdf:Keywords>Cortex-M, Cortex-M0, Cortex-M1, Cortex-M3</pdf:Keywords>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">ARMv7-M Architecture Reference¬†Manual</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ARM Limited</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Defines the ARMv7-M architecture profile, the Microcontroller (MCU) profile, and its extensions, including the optional DSP extension and Floating-point extension. This profile implements the Thumb Instruction Set, a simple Protected Memory System Architecture (PMSA), and a vectored interrupt controller that provides low latency interrupt processing. The document includes the ARMv7-M Debug architecture specification, including the Debug Access Port (DAP), Instrumentation Trace Macrocell (ITM), Data Watchpoint and Trace unit (DWT), Trace Port Interface Unit (TPIU), and Flash Patch and Breakpoint Unit (FPB).</rdf:li>
            </rdf:Alt>
         </dc:description>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:pdfx="http://ns.adobe.com/pdfx/1.3/">
         <pdfx:Copyright>Copyright ¬©‚Ç¨2006-2008, 2010 ARM Limited. All rights reserved.</pdfx:Copyright>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:xapMM="http://ns.adobe.com/xap/1.0/mm/">
         <xapMM:DocumentID>uuid:90cdf424-597f-4fac-8628-97a0921b2ace</xapMM:DocumentID>
         <xapMM:InstanceID>uuid:9b7d93e4-b928-49e2-afd6-59aca6e18cf9</xapMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
</x:xmpmeta>
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                                                                                                    
                           
